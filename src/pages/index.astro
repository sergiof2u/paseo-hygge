---
// Portada provisional mientras llegan los datos de los locales.
// El sitio completo está en borrador.astro (/borrador/).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, instagramUrl, ruta } from '../site';

const locales = (await getCollection('locales', ({ data }) => data.publicado)).sort(
  (a, b) => a.data.orden - b.data.orden,
);
---

<Base menu={false}>
  <section class="hero">
    <img class="hero-foto" src={ruta('/fotos/fachada-sin-cable.jpg')} alt="Fachada del Paseo Hygge sobre la calle 4 de Subachoque" width="2172" height="724" />
  </section>

  <section class="pronto">
    <div class="container pronto-grid">
      <div>
        <p class="eyebrow">Página en construcción</p>
        <h1>Muy pronto, todo el Paseo en un solo lugar</h1>
        <p class="pronto-texto">
          Estamos armando la página del Paseo Hygge: qué encuentras en cada local, sus horarios y cómo llegar.
          Mientras tanto, síguenos en Instagram o ven a recorrerlo.
        </p>
        <div class="acciones">
          <a class="boton" href={instagramUrl} rel="noopener">Instagram @{site.instagram}</a>
          <a class="boton boton--claro" href={site.mapa} rel="noopener">Cómo llegar</a>
        </div>
        <p class="pronto-direccion">{site.direccion}, {site.distancia}.</p>
      </div>

      <div class="recorrido">
        <h2>Los locales</h2>
        <p class="recorrido-nota">En el orden en que los encuentras al recorrer el Paseo.</p>
        <ol>
          {locales.map(({ data }) => (
            <li>
              {data.instagram ? (
                <a href={`https://www.instagram.com/${data.instagram}/`} rel="noopener">{data.nombre}</a>
              ) : (
                <span>{data.nombre}</span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</Base>
