---
// El sitio completo vivió aquí hasta el lanzamiento. Quien llegue con un enlace
// viejo (por ejemplo /borrador/#nona) pasa a la portada, con el mismo ancla.
import { ruta } from '../site';
const destino = ruta('/');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <link rel="canonical" href={new URL(destino, Astro.site)} />
    <title>El Paseo Hygge</title>
    <script is:inline define:vars={{ destino }}>location.replace(destino + location.hash);</script>
  </head>
  <body>
    <p><a href={destino}>El Paseo Hygge</a></p>
  </body>
</html>
